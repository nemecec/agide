{
  "name": "agide",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "electron-vite build && playwright test",
    "coverage:e2e": "node scripts/coverage-e2e.mjs",
    "mutation": "node scripts/mutation-checks.mjs",
    "parity": "node scripts/parity.mjs",
    "visual-check": "node scripts/visual-check.mjs",
    "blocks-docs": "node scripts/blocks-docs.mjs",
    "e2e:claude-mcp": "node scripts/e2e-claude-mcp.mjs",
    "e2e:real-claude": "electron-vite build && node scripts/e2e-real-claude.mjs",
    "e2e:real-claude-inbox": "electron-vite build && node scripts/e2e-real-claude-inbox.mjs",
    "e2e:real-claude-m3": "electron-vite build && node scripts/e2e-real-claude-m3.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm e2e"
  },
  "dependencies": {
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dockview-react": "8.9.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "45.3.3",
    "electron-vite": "6.0.0",
    "jsdom": "^31.0.1",
    "monocart-coverage-reports": "^3.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
